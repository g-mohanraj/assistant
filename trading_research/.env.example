# Trading Research System - Environment Variables
# Copy this file to .env and fill in values

# Optional: path to raw data directory (defaults to data/raw/)
DATA_RAW_DIR=data/raw

# Optional: path to processed data directory (defaults to data/processed/)
DATA_PROCESSED_DIR=data/processed

# Optional: experiment log path (defaults to experiments/experiment_log.jsonl)
EXPERIMENT_LOG_PATH=experiments/experiment_log.jsonl

# Optional: random seed for reproducibility (defaults to 42)
RANDOM_SEED=42
